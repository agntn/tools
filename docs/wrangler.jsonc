{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agntn-tools",
  "account_id": "6ef8d3cbe19975e93d994f25228488e7",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NUXT_SITE_URL": "https://tools.agntn.dev",
  },
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agntn-tools",
      "database_id": "67fa4ced-8e14-4549-a17f-9ec023da75c1",
    },
  ],
  "routes": [{ "pattern": "tools.agntn.dev", "custom_domain": true }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },

  // Previews
  "previews": {
    "vars": {
      "NUXT_SITE_URL": "https://tools.agntn.dev",
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "89992ffd-b2c3-43e5-8954-e776b10a451f",
      },
    ],
  },
}
