{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  /* ai, h3, pi and omp stay out: their hosts' own declarations fail without skipLibCheck. */
  "files": ["dist/index.d.mts", "dist/cli.d.mts", "dist/mcp.d.mts"]
}
