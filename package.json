{
  "name": "@agntn/tools",
  "version": "0.0.0",
  "private": true,
  "description": "One tool definition for MCP, Pi, OMP and the AI SDK",
  "homepage": "https://github.com/agntn/tools#readme",
  "bugs": "https://github.com/agntn/tools/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/tools.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./pi": {
      "types": "./dist/pi.d.mts",
      "import": "./dist/pi.mjs"
    },
    "./omp": {
      "types": "./dist/omp.d.mts",
      "import": "./dist/omp.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    }
  },
  "scripts": {
    "build": "obuild",
    "lint": "vp lint && vp fmt --check",
    "lint:fix": "vp lint --fix && vp fmt",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vp test run",
    "test:watch": "vp test watch"
  },
  "devDependencies": {
    "@agntn/ox": "0.1.0",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@oh-my-pi/pi-coding-agent": "18.0.0",
    "@types/node": "26.2.0",
    "ai": "7.0.66",
    "obuild": "0.4.38",
    "typebox": "1.3.34",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <1",
    "@modelcontextprotocol/server": ">=2.2.0 <3",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "ai": ">=7.0.0 <8"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
